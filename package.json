{
  "name": "web-ui-auditor",
  "description": "Chrome MV3 extension that audits websites: discovers same-origin routes and interactive elements, explores safe interactions, captures UI-state screenshots, and generates an offline interactive report.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm clean && pnpm build:panel && pnpm build:bg && pnpm build:content",
    "build:panel": "vite build",
    "build:bg": "vite build --config vite.background.config.ts",
    "build:content": "esbuild src/content/index.ts --bundle --format=iife --outfile=dist/content.js --minify",
    "build:validate": "node scripts/validate-build.mjs",
    "package:release": "node scripts/package-release.mjs",
    "check:release-tag": "node scripts/check-release-tag.mjs",
    "clean": "node scripts/clean-dist.mjs",
    "watch:bg": "vite build --config vite.background.config.ts --watch",
    "watch:panel": "vite build --watch",
    "serve:fixture": "node scripts/serve-fixture.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "jszip": "^3.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
