{
  "manifest_version": 3,
  "name": "Web UI Auditor",
  "version": "0.1.0",
  "description": "Audits the current website: discovers same-origin routes and interactive elements, explores safe interactions, captures screenshots, and generates an offline audit report.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "downloads",
    "webNavigation"
  ],
  "host_permissions": [],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Open Web UI Auditor"
  }
}
